# Token de nivel de app (Socket Mode) — empieza con xapp-
# Obtenerlo en: api.slack.com/apps → tu app → Socket Mode → App-Level Tokens
SLACK_APP_TOKEN=xapp-1-...

# Bot Token — empieza con xoxb-
# Obtenerlo en: api.slack.com/apps → tu app → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...

# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...  # service_role key, NO la anon
