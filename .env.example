# OPENCLAW_GATEWAY_TOKEN=
# MTG_GATEWAY_MOCK=1
# MTG_GRAPH_MOCK=1
# MTG_GRAPH_CLIENT_STATE=
# MTG_WEBHOOK_PUBLIC_URL=https://qppfampapbxdgednkofc.supabase.co/functions/v1/mtg-graph-webhook
# MTG_RECORDINGS_ENABLED=false

# --- Portal del cliente (docs/portal/RUNBOOK.md) ---
# Front del portal (build separado: npm run build:portal → dist-portal/). Proyecto Supabase EXCLUSIVO de Kawiil OS:
# VITE_PORTAL_SUPABASE_URL=https://kawiil-os-project.supabase.co
# VITE_PORTAL_SUPABASE_PUBLISHABLE_KEY=
# VITE_PORTAL_PUBLIC_URL=https://portal.ejemplo.mx
# Demo espejo (Corte 4): banner y chip «DEMO». Solo en el despliegue de demostración.
# VITE_PORTAL_DEMO_MODE=true
# Ocultar fixtures is_test / «ejemplos didácticos» en sesión autenticada (default: ocultos).
# Solo opt-out explícito: VITE_PORTAL_HIDE_DIDACTIC=false
# VITE_PORTAL_HIDE_DIDACTIC=true
# Bootstrap OS (solo env local; nunca committear refs/llaves):
# KAWIIL_OS_TARGET=kawiil-os-ensayo   # o kawiil-os-demo
# KAWIIL_OS_PROJECT_REF=
# KAWIIL_OS_DB_URL=                   # requerido para bootstrap-demo / portal:demo-reset remoto
# Cruce central↔OS: CENTRAL_SUPABASE_URL CENTRAL_ANON_KEY KAWIIL_OS_SUPABASE_URL KAWIIL_OS_ANON_KEY

# Cloudflare Turnstile (registro, recuperación y reenvío). Sin llave, esas pantallas quedan CERRADAS.
# Pruebas/previews: 1x00000000000000000000AA (siempre pasa), 2x00000000000000000000AB (siempre bloquea),
#                   3x00000000000000000000FF (fuerza reto interactivo)
# VITE_TURNSTILE_SITE_KEY=
# Edge Functions → Secrets (NUNCA en Vite):
# PORTAL_PUBLIC_URL=https://portal.ejemplo.mx          (enlaces de correo y redirecciones de Auth)
# CENTRAL_PUBLIC_URL=https://os.ejemplo.mx              (enlace del aviso de Slack a la bandeja «Clientes»)
# PORTAL_ALLOWED_ORIGIN=https://portal.ejemplo.mx       (CORS de portal-api; * si se omite)
# PORTAL_EMISOR=prueba                                  (prueba = no timbra; pac = plantilla, se niega a emitir hasta conectar el PAC)
# PORTAL_MIRROR_READ_ONLY=true                          (Corte 3: el cliente no carga XML ni emite; false solo en ensayos posteriores)
# PORTAL_CSD_KEY_SECRET=                                (≥32; cifra .cer y .key del CSD. DEBE ser distinto de MOFFIN_FIEL_SECRET y de PORTAL_CSD_SECRET)
# PORTAL_CSD_SECRET=                                    (≥32; cifra la contraseña de la llave del CSD. Distinto de los otros dos)
# PORTAL_SLACK_CHANNEL_ID=                              (canal del aviso «mensaje nuevo de cliente»; usa SLACK_BOT_TOKEN existente)
# PORTAL_EMAIL_SENDER=avisos@ejemplo.mx                 (buzón que envía por Microsoft Graph; usa AZURE_*/MICROSOFT_* existentes)
# PORTAL_DROPBOX_APP_KEY=                               (app de Dropbox PROPIA del portal, acceso limitado a Kawiil Mx/CLIENTES)
# PORTAL_DROPBOX_APP_SECRET=
# PORTAL_DROPBOX_REFRESH_TOKEN=
# PORTAL_DROPBOX_ROOT=/Kawiil Mx/CLIENTES
# PORTAL_DROPBOX_PATH_ROOT=                             (opcional: namespace_id si la carpeta está en el espacio de equipo)
# TURNSTILE_SECRET_KEY=                                 (Edge; sin ella el registro se CIERRA. Prueba: 1x0000000000000000000000000000000AA pasa,
#                                                         2x0000000000000000000000000000000AA falla, 3x0000000000000000000000000000000AA «token ya usado»)
# PORTAL_RL_IP_PER_WINDOW=10                            (intentos por IP por ventana en registro/recuperación/reenvío)
# PORTAL_RL_EMAIL_PER_WINDOW=3                          (intentos por correo por ventana)
# PORTAL_RL_WINDOW_SECONDS=3600
# PORTAL_RL_SALT=                                       (sal de las huellas de IP/correo; si falta usa la service role key)
# OPENCLAW_GATEWAY_URL=                                 (único punto de salida al modelo; vacío = sugerencias apagadas)
# OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_MODEL=
# OPENCLAW_GATEWAY_PATH=/v1/chat/completions
# Comunicación firmada entre proyectos. Cada valor se configura solo en las Edge Functions del lado indicado.
# CENTRAL_TO_OS_SIGNING_SECRET=                         (mismo valor en emisor central y receptor Kawiil OS; ≥32, rotable)
# OS_TO_CENTRAL_SIGNING_SECRET=                         (mismo valor en emisor Kawiil OS y receptor central; distinto al anterior)
# CENTRAL_SYSTEM_API_URL=https://central-project.supabase.co/functions/v1/central-portal-api
# CRON_SECRET=                                          (invoca portal-system-dispatch; distinto a las firmas)
