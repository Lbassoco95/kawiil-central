VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Web Push (VAPID): generar con: npx web-push generate-vapid-keys
# - Public Key → VITE_VAPID_PUBLIC_KEY (frontend / Lovable Environment) y VAPID_PUBLIC_KEY (Supabase secret)
# - Private Key → solo VAPID_PRIVATE_KEY en Supabase Edge Functions secrets (nunca en Vite)
# - VAPID_CONTACT_EMAIL en Supabase (ej. mailto:hola@tudominio.com) — usa slack-events para enviar push
VITE_VAPID_PUBLIC_KEY=

# Importante: No cambiar estos valores sin coordinar con el equipo
# El proyecto actual de Supabase es: qppfampapbxdgednkofc

# --- Microsoft 365 (calendario / correo) — solo secretos en Supabase Edge Functions ---
# App Registration (Azure / Entra ID). Si aparece AADSTS7000222 o invalid_client al
# guardar eventos, el client secret expiró: renovar en Azure → Certificates & secrets
# y actualizar MICROSOFT_CLIENT_SECRET (ver docs/multi-cuenta-calendario-correo.md §5).
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=
# AZURE_CLIENT_ID=          # alias usado por algunas funciones de mail/pipeline
# AZURE_CLIENT_SECRET=

# --- SATgo (CSF / opinión 32D) — secretos solo en Supabase → Edge Functions ---
# Predeterminado: e.firma JWE (POST /api/v2/Consultar/csffiel|/ocfiel + X-Fiel-Encryption).
# Docs cifrado: https://sat-go.com/cifrar-efirma
# Fallback: GET /csf|/oc con RFC + Secret/CIEC si el cliente no tiene JWE.
# Flujo key: portal web.sat-go.com → Createkey → SATGO_API_KEY (o Vault satgo_api_key);
# Edge canjea JWT en /api/Auth/token-json.
# SATGO_API_KEY=
# SATGO_ACCESS_TOKEN=  (opcional; JWT directo, caduca)
# SATGO_BASE_URL=https://api.sat-go.com
# SATGO_FETCH_TIMEOUT_MS=90000
# Opt-out (volver CSF/32D a Moffin vía moffin-query): SAT_CSF_PROVIDER=moffin
# SAT_CSF_PROVIDER=satgo

# --- Moffin (lista 69-B / CFDI / opt-out CSF) — front (Vite) + secretos en Supabase → Edge Functions ---

#
# Con SATgo activo, Moffin Solutions ya no es obligatorio para CSF/32D.
# Opt-out legacy FIEL: VITE_MOFFIN_API_FLAVOR=legacy (build) y MOFFIN_API_FLAVOR=legacy (Edge).
#
# Checklist SATgo + Moffin:
#   1) Edge Secrets: SATGO_API_KEY; MOFFIN_SAT_CIEC_SECRET o MOFFIN_FIEL_SECRET (≥32);
#      MOFFIN_API_KEY si usáis lista 69-B.
#   2) Desplegar moffin-query, moffin-monthly-sat, moffin-health, moffin-sat-ciec.
#   3) Tabla moffin_client_sat_ciec (migración existente).
#
# MOFFIN_API_KEY=
# MOFFIN_BASE_URL=https://app.moffin.mx/api/v1 (opcional; legacy explícito con MOFFIN_API_FLAVOR=legacy)
# API Moffin Solutions (CSF / 32D): es el modo por defecto; legacy solo con MOFFIN_API_FLAVOR=legacy en Edge
# MOFFIN_SOLUTIONS_BASE_URL=https://solutions-api.moffin.mx/api
# Si /oauth/token devuelve 503 HTML, URL explícita POST (sin barra final): MOFFIN_SOLUTIONS_OAUTH_TOKEN_URL=https://solutions-api.moffin.mx/api/oauth/token
# Timeout ms por petición HTTP a Solutions (GET/POST; default 25000, máx. 120000): MOFFIN_SOLUTIONS_FETCH_TIMEOUT_MS=40000
# Moffin Solutions (solutions-api): OAuth recomendado — POST /oauth/token (ver solutions-docs.moffin.mx/apis/authentication)
# MOFFIN_SOLUTIONS_CLIENT_ID=
# MOFFIN_SOLUTIONS_CLIENT_SECRET=
# Opcional: JWT devuelto por oauth (si no usas CLIENT_ID/SECRET en Edge): MOFFIN_SOLUTIONS_BEARER=eyJ...
# Con CLIENT_ID+SECRET en Supabase no hace falta BEARER; un BEARER inválido o caducado provoca 401 en perfil SAT.
# El token «Configuración → API» de app.moffin NO sustituye a CLIENT_ID/CLIENT_SECRET de Solutions.
#
# Esquema "Token" (API key legacy para Solutions): si Moffin te indica que CSF/32D aceptan
# `Authorization: Token <api_key>` en lugar de OAuth Bearer, fuerza el scheme y provee la key.
# Kawiil resolverá la credencial con la prioridad: MOFFIN_SOLUTIONS_API_KEY → MOFFIN_SOLUTIONS_BEARER → MOFFIN_API_KEY.
# MOFFIN_SOLUTIONS_AUTH_SCHEME=token
# MOFFIN_SOLUTIONS_API_KEY=
# Lista 69-B en modo solutions sigue en API legacy:
# MOFFIN_LEGACY_BASE_URL=https://app.moffin.mx/api/v1
# MOFFIN_LEGACY_API_KEY= (opcional; si no, mismo MOFFIN_API_KEY con header Token)
# Cifrado CIEC (Edge: moffin-sat-ciec); si no existe, se usa MOFFIN_FIEL_SECRET
# MOFFIN_SAT_CIEC_SECRET=
# Front: solo si quieres forzar legacy en el bundle (FIEL en Contabilidad)
# VITE_MOFFIN_API_FLAVOR=legacy
# Si Moffin asigna paths distintos por producto (tras confirmar con ellos):
# MOFFIN_QUERY_PATH_SAT_BLACKLIST=/query/sat_blacklist
# MOFFIN_QUERY_PATH_CONSTANCIA_SITUACION_FISCAL=/query/sat_rfc
# MOFFIN_QUERY_PATH_OPINION_CUMPLIMIENTO=/query/sat_rfc
# Parámetro `service` en GET /service_queries (default sat_rfc):
# MOFFIN_SERVICE_QUERIES_SERVICE=sat_rfc
# Tras especificación Moffin: JSON fusionado al body POST (objeto; metadata se mezcla con la de Kawiil):
# MOFFIN_QUERY_EXTRA_BODY_CONSTANCIA_SITUACION_FISCAL={"tipo":"ejemplo"}
# MOFFIN_QUERY_EXTRA_BODY_OPINION_CUMPLIMIENTO={"tipo":"ejemplo"}
# Nombres de campos en el JSON de respuesta que contienen URL de PDF (coma-separados):
# MOFFIN_SAT_RFC_EXTRA_PDF_FIELD_NAMES=constanciaPdfUrl,opinionPdfUrl
# Cifrado de .cer/.key por cliente (Edge: moffin-fiel, moffin-query). Mínimo 32 caracteres.
# MOFFIN_FIEL_SECRET=
# Opcional: nombres de campos en POST /query/sat_rfc si Moffin los documenta distinto (default certificate, privateKey, password)
# MOFFIN_FIEL_FIELD_CERT=certificate
# MOFFIN_FIEL_FIELD_KEY=privateKey
# MOFFIN_FIEL_FIELD_PASSWORD=password
# Si la llave es PEM de texto, prueba: MOFFIN_FIEL_KEY_FORMAT=utf8
# MOFFIN_FIEL_CERT_FORMAT=b64
# MOFFIN_FIEL_KEY_FORMAT=b64
# (Sandbox: https://sandbox.moffin.mx/api/v1)
# Webhook (Edge moffin-webhook): Solutions notifica CSF/32D con POST JSON directo (sin Svix); MOFFIN_SVIX opcional ahí.
# Si algún producto sigue usando Svix (cabeceras svix-id / svix-timestamp / svix-signature), copiar Signing secret (whsec_...).
# MOFFIN_SVIX_SIGNING_SECRET=

# --- Slack (usuario OAuth + Event API) — secretos solo en Supabase Edge, no en Vite ---
# SLACK_CLIENT_ID= (misma app que SLACK_BOT_TOKEN o app con User Token + Event Subscriptions)
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET= (Signing secret de la app; slack-events valida cada payload)
# SLACK_BOT_TOKEN=xoxb-… (instalación del bot en el workspace; conversations.members / history / chat.postMessage)
# Event Subscriptions → Subscribe to bot events: message.channels, message.groups, message.im, message.mpim, reaction_added
# Desplegar: supabase functions deploy slack-events --no-verify-jwt
# VAPID_PUBLIC_KEY=   (igual que VITE_VAPID_PUBLIC_KEY)
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT_EMAIL=mailto:equipo@tudominio.com
# APP_ORIGIN=https://tu-dominio-kawiil.com (redirect post-OAuth en popup; debe coincidir con el origen del front o omitir para usar * en postMessage)
# Checklist enlaces Slack (misma URL base que VITE_SUPABASE_URL / project_id):
#   OAuth Redirect URL: https://qppfampapbxdgednkofc.supabase.co/functions/v1/slack-user-callback
#   Event Subscriptions URL: https://qppfampapbxdgednkofc.supabase.co/functions/v1/slack-events

# --- Savio (cuentas por cobrar) — NUNCA en Vite; solo secretos de Edge Functions en Supabase ---
# Si una API key se expuso (chat, ticket, repo), revocarla en Savio y crear otra antes de continuar.
#
# Supabase Dashboard → Project Settings → Edge Functions → Secrets:
#   SAVIO_API_KEY              = API key (sandbox o producción)
#   SAVIO_API_BASE_URL         = https://api.savio.mx o https://api.savio.mx/api/v1 (prod; el código añade /api/v1 si falta)
#                               https://api-sandbox.savio.mx o …/api/v1 (sandbox)
#   SAVIO_API_AUTH_MODE        = opcional: raw (defecto, clave en header Authorization tal cual) | bearer (Authorization: Bearer <clave>)
#   SAVIO_WEBHOOK_SECRET       = opcional; si Savio firma webhooks, configurar y endurecer savio-webhook
#
# Webhook (Savio → Kawiil): URL pública
#   https://qppfampapbxdgednkofc.supabase.co/functions/v1/savio-webhook
# Desplegar siempre con JWT desactivado para esta función:
#   supabase functions deploy savio-webhook --no-verify-jwt
#
# Dashboard Finanzas → pestaña Ingresos (Savio): datos vía API (savio-finance-api) + webhooks.
#   supabase functions deploy savio-api-health
#   supabase functions deploy savio-finance-api
# Opcional si Savio cambia rutas (defecto en código: /invoice, /payment, /customer — OpenAPI prod/sandbox):
#   SAVIO_API_PATH_INVOICES=/invoice
#   SAVIO_API_PATH_PAYMENTS=/payment
#   SAVIO_API_PATH_CUSTOMERS=/customer
#   SAVIO_API_HEALTH_PATH=/invoice   (savio-api-health; limit=10 fijo en la petición)
#
# Probar salud API (usuario con acceso Finanzas):
#   curl -s "$SUPABASE_URL/functions/v1/savio-api-health" -H "Authorization: Bearer $USER_JWT" | jq .
#
# Verificación webhook E2E (sandbox): en app-sandbox.savio.mx disparar evento de prueba o factura/pago test;
# luego en Supabase → Table Editor → savio_webhook_events (o logs de savio-webhook).
#
# Permiso adicional ingresos Savio (además de módulo Finanzas / celula finanzas):
# Migración finance_income_viewers + RPC can_view_savio_finance.
# Tras migrar, en SQL Editor insertar filas en public.finance_income_viewers (ver comentario en la migración).
#
# Escritura (crear cargo / registrar pago / cliente): columna can_write_savio en finance_income_viewers + RPC can_write_savio_finance.
# Los usuarios con rol Kawiil «transformador» y fila en finance_income_viewers tienen escritura por política (ver migración savio_write_transformador).
# Edge Function savio-finance-write (mismos secretos SAVIO_API_* que savio-finance-api). Desplegar tras migración.

# --- Finanzas (Vite, opcional) ---
# Máx. páginas Savio por ventana en el dashboard ejecutivo (cada página hasta 100 filas; techo interno 50).
# El botón «Cargar más» en resumen suma páginas extra por paso (constante SAVIO_FINANCE_PAGE_BOOST_STEP en código).
# VITE_SAVIO_FINANCE_MAX_PAGES=15
# Cartera (facturas, ventana larga): por defecto el doble del tope anterior; se puede fijar aparte.
# VITE_SAVIO_FINANCE_PORTFOLIO_MAX_PAGES=25
# Enlace «Abrir en Savio» en Finanzas (panel web prod o sandbox).
# VITE_SAVIO_APP_URL=https://app.savio.mx

# --- Múuch' (módulo de Juntas) ---
