VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Web Push (VAPID): generar con: npx web-push generate-vapid-keys
# - Public Key → VITE_VAPID_PUBLIC_KEY (frontend / Lovable Environment) y VAPID_PUBLIC_KEY (Supabase secret)
# - Private Key → solo VAPID_PRIVATE_KEY en Supabase Edge Functions secrets (nunca en Vite)
# - VAPID_CONTACT_EMAIL en Supabase (ej. mailto:hola@tudominio.com) — usa slack-events para enviar push
VITE_VAPID_PUBLIC_KEY=

# Importante: No cambiar estos valores sin coordinar con el equipo
# El proyecto actual de Supabase es: qppfampapbxdgednkofc

# --- Moffin (consultas SAT) — solo secretos en Supabase → Edge Functions ---
# MOFFIN_API_KEY=
# MOFFIN_BASE_URL=https://app.moffin.mx/api/v1
# Cifrado de .cer/.key por cliente (Edge: moffin-fiel, moffin-query). Mínimo 32 caracteres.
# MOFFIN_FIEL_SECRET=
# Opcional: nombres de campos en POST /query/sat_rfc si Moffin los documenta distinto (default certificate, privateKey, password)
# MOFFIN_FIEL_FIELD_CERT=certificate
# MOFFIN_FIEL_FIELD_KEY=privateKey
# MOFFIN_FIEL_FIELD_PASSWORD=password
# Si la llave es PEM de texto, prueba: MOFFIN_FIEL_KEY_FORMAT=utf8
# MOFFIN_FIEL_CERT_FORMAT=b64
# MOFFIN_FIEL_KEY_FORMAT=b64
# (Sandbox: https://sandbox.moffin.mx/api/v1)
# Webhook Svix (función moffin-webhook): copiar Signing secret del portal (whsec_...)
# MOFFIN_SVIX_SIGNING_SECRET=

# --- Slack (usuario OAuth + Event API) — secretos solo en Supabase Edge, no en Vite ---
# SLACK_CLIENT_ID= (misma app que SLACK_BOT_TOKEN o app con User Token + Event Subscriptions)
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET= (ya usado en slack-events)
# VAPID_PUBLIC_KEY=   (igual que VITE_VAPID_PUBLIC_KEY)
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT_EMAIL=mailto:equipo@tudominio.com
# APP_ORIGIN=https://tu-dominio-kawiil.com (redirect post-OAuth en popup)

# --- Savio (cuentas por cobrar) — NUNCA en Vite; solo secretos de Edge Functions en Supabase ---
# Si una API key se expuso (chat, ticket, repo), revocarla en Savio y crear otra antes de continuar.
#
# Supabase Dashboard → Project Settings → Edge Functions → Secrets:
#   SAVIO_API_KEY              = API key (sandbox o producción)
#   SAVIO_API_BASE_URL         = https://api-sandbox.savio.mx  (sandbox) | https://api.savio.mx (producción)
#   SAVIO_API_AUTH_MODE        = opcional: raw (defecto, clave en header Authorization tal cual) | bearer (Authorization: Bearer <clave>)
#   SAVIO_WEBHOOK_SECRET       = opcional; si Savio firma webhooks, configurar y endurecer savio-webhook
#
# Webhook (Savio → Kawiil): URL pública
#   https://qppfampapbxdgednkofc.supabase.co/functions/v1/savio-webhook
# Desplegar siempre con JWT desactivado para esta función:
#   supabase functions deploy savio-webhook --no-verify-jwt
#
# Dashboard Finanzas → pestaña Ingresos (Savio): datos vía API (savio-finance-api) + webhooks.
#   supabase functions deploy savio-api-health
#   supabase functions deploy savio-finance-api
# Opcional si Savio cambia rutas (defecto en código: /invoice, /payment, /customer — OpenAPI prod/sandbox):
#   SAVIO_API_PATH_INVOICES=/invoice
#   SAVIO_API_PATH_PAYMENTS=/payment
#   SAVIO_API_PATH_CUSTOMERS=/customer
#   SAVIO_API_HEALTH_PATH=/invoice   (savio-api-health; limit=10 fijo en la petición)
#
# Probar salud API (usuario con acceso Finanzas):
#   curl -s "$SUPABASE_URL/functions/v1/savio-api-health" -H "Authorization: Bearer $USER_JWT" | jq .
#
# Verificación webhook E2E (sandbox): en app-sandbox.savio.mx disparar evento de prueba o factura/pago test;
# luego en Supabase → Table Editor → savio_webhook_events (o logs de savio-webhook).
#
# Permiso adicional ingresos Savio (además de módulo Finanzas / celula finanzas):
# Migración finance_income_viewers + RPC can_view_savio_finance.
# Tras migrar, en SQL Editor insertar filas en public.finance_income_viewers (ver comentario en la migración).
