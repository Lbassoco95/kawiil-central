VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Web Push (VAPID): generar con npx web-push generate-vapid-keys — la pública va al cliente
VITE_VAPID_PUBLIC_KEY=

# Importante: No cambiar estos valores sin coordinar con el equipo
# El proyecto actual de Supabase es: qppfampapbxdgednkofc

# --- Slack (usuario OAuth + Event API) — secretos solo en Supabase Edge, no en Vite ---
# SLACK_CLIENT_ID= (misma app que SLACK_BOT_TOKEN o app con User Token + Event Subscriptions)
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET= (ya usado en slack-events)
# VAPID_PUBLIC_KEY= (duplicado de VITE_ para Edge push-notifications)
# VAPID_PRIVATE_KEY=
# APP_ORIGIN=https://tu-dominio-kawiil.com (redirect post-OAuth en popup)
